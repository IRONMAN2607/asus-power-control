[Unit]
Description=Apply ASUS power-source policy through PPD and Cardwire
Requires=asusd.service asus-shutdown.service cardwired.service power-profiles-daemon.service upower.service
After=asusd.service asus-shutdown.service cardwired.service power-profiles-daemon.service upower.service

[Service]
Type=oneshot
ExecStart=/usr/local/bin/asus-power-mode auto
TimeoutStartSec=90s
StateDirectory=asus-power-mode
StateDirectoryMode=0755

[Install]
# Fedora PPD is ordered after multi-user.target; using it here creates a cycle.
WantedBy=graphical.target
